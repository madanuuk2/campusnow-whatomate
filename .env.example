# CampusNow production deployment environment template.
# Copy to .env on the deployment server and replace every placeholder.

# Immutable GHCR image reference. Use a full Git commit SHA tag.
# Format: ghcr.io/<GITHUB_OWNER>/campusnow-whatomate:<FULL_GIT_SHA>
WHATOMATE_IMAGE=<GHCR_IMAGE_WITH_FULL_GIT_SHA_TAG>

# Server timezone (for example, an IANA timezone identifier).
TZ=<IANA_TIMEZONE>

# PostgreSQL initialization and application database credentials.
# These values must remain aligned with the initialized postgres-data volume.
POSTGRES_USER=<DATABASE_USER>
POSTGRES_PASSWORD=<GENERATE_DATABASE_PASSWORD>
POSTGRES_DB=<DATABASE_NAME>

# Encrypts sensitive per-organization credentials stored in PostgreSQL.
# Generate once, keep it secure, and keep it stable across container replacements.
WHATOMATE_APP__ENCRYPTION_KEY=<GENERATE_32_PLUS_CHARACTER_SECRET>

# Signs application JWTs. Generate once, keep it secure, and keep it stable
# across container replacements to avoid invalidating active sessions.
WHATOMATE_JWT__SECRET=<GENERATE_32_PLUS_CHARACTER_SECRET>

# Used only to bootstrap the first administrator on an empty database.
# Remove these values from .env after initial setup is confirmed.
WHATOMATE_DEFAULT_ADMIN__EMAIL=<INITIAL_ADMIN_EMAIL>
WHATOMATE_DEFAULT_ADMIN__PASSWORD=<GENERATE_INITIAL_ADMIN_PASSWORD>
WHATOMATE_DEFAULT_ADMIN__FULL_NAME=<INITIAL_ADMIN_NAME>
